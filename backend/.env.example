OTTO_ENVIRONMENT=local
OTTO_DATABASE_URL=postgresql+psycopg://otto:otto@localhost:5432/otto
# Clerk Frontend API URL (Dashboard -> API keys -> Frontend API URL)
OTTO_CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# Your Clerk user ID (Dashboard -> Users). Comma-separated if more than one.
OTTO_ALLOWED_USER_IDS=user_xxxxxxxxxxxxxxxxxxxxxxxx
# Plaid keys (Dashboard -> Developers -> Keys). Use the sandbox secret until Production is approved.
OTTO_PLAID_CLIENT_ID=
OTTO_PLAID_SECRET=
OTTO_PLAID_ENV=sandbox
# Encrypts Plaid access tokens at rest. Generate:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OTTO_TOKEN_ENCRYPTION_KEY=
