# Real bank data: `make dev-live` loads this on top of .env. Copy to .env.live (gitignored).
#
# A separate database keeps real balances and transactions away from sandbox data, so
# `make dev` (sandbox) and `make dev-live` (real) never mix. The Plaid client ID is the
# same in both environments; only the secret differs.
OTTO_DATABASE_URL=postgresql+psycopg://otto:otto@otto-financial-postgres-1.orb.local:5432/otto_live
OTTO_PLAID_ENV=production
# Dashboard -> Developers -> Keys -> Production secret
OTTO_PLAID_SECRET=476f6566b1a1d99540f34490294d87
